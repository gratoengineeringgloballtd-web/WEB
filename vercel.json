{
  "buildCommand": "node -e \"require('fs').mkdirSync('vercel-out',{recursive:true});require('fs').writeFileSync('vercel-out/index.html','Grato API')\"",
  "outputDirectory": "vercel-out",
  "functions": { "api/index.js": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
