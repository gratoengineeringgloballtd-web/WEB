# Copy to .env and fill in. On Vercel, add the same names under Project → Settings → Environment Variables.

# ---------- Website ----------
# Use "hash" only if your host cannot send every URL to index.html.
VITE_ROUTER=browser

# ---------- Shop & referral API (server only — never prefix these with VITE_) ----------
# MongoDB Atlas → Database → Connect → Drivers. Allow Vercel's IPs (or 0.0.0.0/0) in Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=grato
# Only if you see "querySrv ETIMEOUT" on your computer: use public DNS for the database lookup.
MONGODB_DNS=
# Random string, at least 32 characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public address of the site, used for payment redirects (no trailing slash).
SITE_URL=https://gratoglobal.com

# Cloudinary (file storage for photos, CVs and quote attachments).
# Cloudinary dashboard → Settings → API Keys → copy the "API environment variable".
# Leave empty to store files in MongoDB instead.
CLOUDINARY_URL=
# Optional: top folder in your Cloudinary media library (default: grato).
CLOUDINARY_FOLDER=grato

# Flutterwave → Settings → API keys. Leave empty to run payments in test mode (local only).
FLW_SECRET_KEY=
# Flutterwave → Settings → Webhooks: set the URL to https://YOUR-SITE/api/webhooks/flutterwave and a secret hash; put the same hash here.
FLW_SECRET_HASH=
# Set to true only for a staging site that should accept simulated payments without Flutterwave.
ALLOW_TEST_PAYMENTS=false

# First admin account, created by `npm run seed`. Change the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
